# Base de la API de base-shop, sin el prefijo /v1 ni barra final.
# El origen de este backoffice debe estar en CORS_ALLOWED_ORIGINS del backend.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Versión vigente del aviso de privacidad, la misma que usa la tienda (GAPS G-19, D-068).
# Vacía, los pedidos de la tienda física no aceptan invitados.
NUXT_PUBLIC_PRIVACY_NOTICE_VERSION=
