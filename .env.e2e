# Configuración fija del build que usan las E2E (`npm run build:e2e`): no depende del .env local.
# La API se simula en tests/e2e con esta misma base (E2E_API_BASE_URL).
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Vacía: los pedidos de la tienda física no aceptan invitados (GAPS G-19), como espera sales.spec.ts.
NUXT_PUBLIC_PRIVACY_NOTICE_VERSION=
